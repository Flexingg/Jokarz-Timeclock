<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Required so the in-app button can send the owner to the battery-optimisation exemption.
         ColorOS/Android otherwise freeze or kill the foreground service and the live chronometer
         chip would stop ticking. This app is self-hosted/sideloaded, not distributed via Play. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 16 Live Updates: a normal (install-time) permission the system requires before it
         will promote the ongoing shift notification to a status bar chip. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Opt-in "run a Tasker task on clock in/out" path (TaskerIntent external API). The permission
         is Tasker's own; the app asks for it only when the owner enables that setting, and nothing
         else in the app depends on it. -->
    <uses-permission android:name="net.dinglisch.android.tasker.PERMISSION_RUN_TASKS" />
    <!-- Exporting the Tasker profile file needs to write to public Downloads on Android 9 and below;
         Android 10+ uses MediaStore scoped storage, which needs no permission at all. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Package visibility (API 30+): without this, getPackageInfo/getLaunchIntentForPackage report
         Tasker as not installed even when it is. -->
    <queries>
        <package android:name="net.dinglisch.android.taskerm" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.JokarzTimeclock">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.JokarzTimeclock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Intent filter for Tasker, notifications and shortcuts -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jokarz" android:host="timeclock" />
            </intent-filter>
        </activity>

        <service
            android:name=".engine.LiveShiftService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live ongoing shift tracking, chronometer and milestone monitoring" />
        </service>

        <!-- Exported with no permission guard so Tasker can reach it. Android 8+ (API 26) does not
             deliver implicit broadcasts to a manifest-declared receiver, so Tasker's Send Intent must
             set Package = com.randallengineering.jokarztimeclock (explicit broadcast), or use the
             jokarz://timeclock deep link instead. An Action-only Send Intent is silently dropped:
             that was the "Tasker doesn't work" failure before v2.8.0. -->
        <receiver
            android:name=".engine.GeofenceBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.randallengineering.jokarztimeclock.ACTION_CLOCK_IN" />
                <action android:name="com.randallengineering.jokarztimeclock.ACTION_CLOCK_OUT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
