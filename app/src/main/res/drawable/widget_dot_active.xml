<?xml version="1.0" encoding="utf-8"?>
<!-- Status light: a solid dot inside a soft halo of the same colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:endColor="#009BE7A8" android:gradientRadius="7dp" android:startColor="#739BE7A8" android:type="radial" />
            <size android:width="14dp" android:height="14dp" />
        </shape>
    </item>
    <item android:bottom="3.5dp" android:left="3.5dp" android:right="3.5dp" android:top="3.5dp">
        <shape android:shape="oval">
            <solid android:color="#FF9BE7A8" />
        </shape>
    </item>
</layer-list>
