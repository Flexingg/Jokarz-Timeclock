<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <FrameLayout android:id="@+id/widget_action_row" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/widget_action_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/w_pill" android:tint="#FFE0A3FF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/widget_action_icon" android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="Clock in or out" android:src="@drawable/ic_widget_play" android:tint="#FF4A0A6B" />
            <Chronometer android:id="@+id/widget_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:maxLines="1" android:textColor="#FF4A0A6B" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/widget_action" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
