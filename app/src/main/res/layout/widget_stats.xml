<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="TODAY"
            android:textColor="#FFCFC2D6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_today_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFEBB2FF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_today_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFCFC2D6"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="PAY PERIOD"
            android:textColor="#FFCFC2D6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_period_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFEBB2FF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_period_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFCFC2D6"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
