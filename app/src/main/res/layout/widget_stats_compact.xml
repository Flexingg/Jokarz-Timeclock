<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/widget_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="18dp" android:paddingTop="14dp" android:paddingEnd="18dp" android:paddingBottom="14dp">
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/w_pill" android:tint="#FF4A2C73" android:id="@+id/widget_today_label_bg" />
                <TextView android:id="@+id/widget_today_label" android:layout_width="match_parent" android:layout_height="match_parent" android:fontFamily="sans-serif-medium" android:letterSpacing="0.1" android:maxLines="1" android:paddingStart="10dp" android:paddingTop="3dp" android:paddingEnd="10dp" android:paddingBottom="3dp" android:text="TODAY" android:textColor="#FFEBB2FF" android:textSize="10sp" />
            </FrameLayout>
        <TextView android:id="@+id/widget_today_money" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="sans-serif-light" android:fontFeatureSettings="tnum" android:maxLines="1" android:textColor="#FFF7EEFB" android:textSize="30sp" />
        <TextView android:id="@+id/widget_today_hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFB3A5BB" android:textSize="12sp" />
        <TextView android:id="@+id/widget_period_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:textColor="#FFB3A5BB" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
