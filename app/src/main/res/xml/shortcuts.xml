<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="clock_in"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_play"
        android:shortcutShortLabel="@string/shortcut_clock_in"
        android:shortcutLongLabel="@string/shortcut_clock_in_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="jokarz://timeclock?action=clock_in"
            android:targetClass="com.randallengineering.jokarztimeclock.MainActivity"
            android:targetPackage="com.randallengineering.jokarztimeclock" />
    </shortcut>
    <shortcut
        android:shortcutId="clock_out"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_stop"
        android:shortcutShortLabel="@string/shortcut_clock_out"
        android:shortcutLongLabel="@string/shortcut_clock_out_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="jokarz://timeclock?action=clock_out"
            android:targetClass="com.randallengineering.jokarztimeclock.MainActivity"
            android:targetPackage="com.randallengineering.jokarztimeclock" />
    </shortcut>
    <shortcut
        android:shortcutId="break"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_pause"
        android:shortcutShortLabel="@string/shortcut_break"
        android:shortcutLongLabel="@string/shortcut_break_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="jokarz://timeclock?action=break"
            android:targetClass="com.randallengineering.jokarztimeclock.MainActivity"
            android:targetPackage="com.randallengineering.jokarztimeclock" />
    </shortcut>
</shortcuts>
